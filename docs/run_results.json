ils_accepted_range_dividend_growth_rate_growth_rate__10___1.1c0841f060", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from \"market_data\".\"public\".\"dividend_growth_rate\"\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not growth_rate >= -1\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not growth_rate <= 10\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:35.012088Z", "completed_at": "2026-05-03T21:31:35.014185Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:35.014398Z", "completed_at": "2026-05-03T21:31:35.014401Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0027773380279541016, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_databases.not_null_dividend_growth_rate_ticker.f4bb573750", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect ticker\nfrom \"market_data\".\"public\".\"dividend_growth_rate\"\nwhere ticker is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:35.015385Z", "completed_at": "2026-05-03T21:31:35.017475Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:35.017678Z", "completed_at": "2026-05-03T21:31:35.017681Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0027391910552978516, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_databases.not_null_dividend_growth_rate_year.1add640fb1", "compiled": true, "compiled_code": "\n    