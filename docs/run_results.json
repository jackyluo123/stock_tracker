{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.8", "generated_at": "2026-05-03T21:31:35.019085Z", "invocation_id": "ca5f7335-2713-48db-b050-be33b62f9a3e", "invocation_started_at": "2026-05-03T21:31:34.482073Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.964111Z", "completed_at": "2026-05-03T21:31:34.968886Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.969208Z", "completed_at": "2026-05-03T21:31:34.969219Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.005666971206665039, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_databases.stg_dividend", "compiled": true, "compiled_code": "-- if we did not clean the data in Python, it would have been done here\nSELECT * \nFROM \"market_data\".\"public\".\"dividend\"", "relation_name": "\"market_data\".\"public\".\"stg_dividend\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.970550Z", "completed_at": "2026-05-03T21:31:34.971553Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.971769Z", "completed_at": "2026-05-03T21:31:34.971773Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0018839836120605469, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_databases.test", "compiled": true, "compiled_code": "SELECT * \r\nFROM dividend\r\nLIMIT 2", "relation_name": "\"market_data\".\"public\".\"test\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.973016Z", "completed_at": "2026-05-03T21:31:34.975010Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.975245Z", "completed_at": "2026-05-03T21:31:34.975248Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0028679370880126953, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_databases.dividend_growth_inception_delta", "compiled": true, "compiled_code": "\n\n/*\n-- THIS IS USING NON-WINDOW FUNCTIONS\nWITH first_date AS (\n   SELECT ticker, MIN(ex_dividend_date) as ex_dividend_date\n   FROM dividend\n   GROUP BY ticker\n),\nfirst_payment AS (\n   SELECT d.ticker, d.amount\n   FROM dividend AS d\n   INNER JOIN first_date AS f\n      ON f.ticker = d.ticker AND f.ex_dividend_date = d.ex_dividend_date\n)\n\nSELECT d.ticker, d.ex_dividend_date, d.amount - f.amount as growth\nFROM dividend AS d\nJOIN first_payment AS f\nON d.ticker = f.ticker\nORDER BY d.ticker, d.ex_dividend_date\n\n*/\n\n-- THIS IS USING WINDOW FUNCTIONS\nSELECT ticker, ex_dividend_date, amount - FIRST_VALUE(amount) OVER (ORDER BY ex_dividend_date) AS growth\nFROM \"market_data\".\"public\".\"stg_dividend\"", "relation_name": "\"market_data\".\"public\".\"dividend_growth_inception_delta\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.976383Z", "completed_at": "2026-05-03T21:31:34.978061Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.978300Z", "completed_at": "2026-05-03T21:31:34.978304Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.002542257308959961, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_databases.dividend_growth_inception_percent", "compiled": true, "compiled_code": "\n\n/*\n-- THIS IS USING NON-WINDOW FUNCTIONS\nWITH first_date AS (\n   SELECT ticker, MIN(ex_dividend_date) as ex_dividend_date\n   FROM dividend\n   GROUP BY ticker\n),\nfirst_payment AS (\n   SELECT d.ticker, d.amount\n   FROM dividend AS d\n   INNER JOIN first_date AS f\n      ON f.ticker = d.ticker AND f.ex_dividend_date = d.ex_dividend_date\n)\n\nSELECT d.ticker, d.ex_dividend_date, (d.amount - f.amount) / f.amount as growth\nFROM dividend AS d\nJOIN first_payment AS f\nON d.ticker = f.ticker\nORDER BY d.ticker, d.ex_dividend_date\n\n*/\n\n-- THIS IS USING WINDOW FUNCTIONS\nWITH difference AS (\n   SELECT ticker, ex_dividend_date, amount, FIRST_VALUE(amount) OVER (PARTITION BY ticker ORDER BY ex_dividend_date) AS first_val\n   FROM \"market_data\".\"public\".\"stg_dividend\"\n)\nSELECT ticker, ex_dividend_date, (amount - first_val) / NULLIF(first_val, 0) AS growth\nFROM difference", "relation_name": "\"market_data\".\"public\".\"dividend_growth_inception_percent\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.979448Z", "completed_at": "2026-05-03T21:31:34.981160Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.981380Z", "completed_at": "2026-05-03T21:31:34.981383Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.002460002899169922, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_databases.dividend_growth_rate", "compiled": true, "compiled_code": "\n\n-- We want to sum up all dividend payments in a year\n-- Then we need to get the difference between x and x-1\n-- Then we can first make a table with just the grouped dividend payments\n\nWITH yearly_payout AS (\n   SELECT \n      ticker, \n      EXTRACT(YEAR FROM ex_dividend_date) AS year, \n      SUM(amount) as payout, \n      COUNT(*) as num_payouts\n   FROM \"market_data\".\"public\".\"stg_dividend\"\n   GROUP BY ticker, EXTRACT(YEAR FROM ex_dividend_date)\n)\nSELECT\n   currYear.ticker,\n   currYear.year,\n   currYear.num_payouts AS payouts_this_year,\n   pastYear.num_payouts AS payouts_last_year,\n   (currYear.payout - pastYear.payout) / NULLIF(pastYear.payout, 0) AS growth_rate\nFROM yearly_payout AS currYear\nLEFT JOIN yearly_payout AS pastYear\n   ON currYear.year = pastYear.year + 1 AND currYear.ticker = pastYear.ticker\nORDER BY currYear.ticker, currYear.year\n\n-- Use LEFT JOIN even though there is no past year on the first year so at least we can see the first year with null data\n-- Not using LEFT JOIN will display the first year with growth data which may seem confusing", "relation_name": "\"market_data\".\"public\".\"dividend_growth_rate\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.982538Z", "completed_at": "2026-05-03T21:31:34.990004Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.990235Z", "completed_at": "2026-05-03T21:31:34.990241Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.008260011672973633, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_databases.not_null_test_ex_dividend_date.a31aac836d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect ex_dividend_date\nfrom \"market_data\".\"public\".\"test\"\nwhere ex_dividend_date is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.991328Z", "completed_at": "2026-05-03T21:31:34.993931Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.994140Z", "completed_at": "2026-05-03T21:31:34.994144Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0033681392669677734, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_databases.not_null_test_ticker.8671266a3e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect ticker\nfrom \"market_data\".\"public\".\"test\"\nwhere ticker is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-03T21:31:34.995149Z", "completed_at": "2026-05-03T21:31:34.997876Z"}, {"name": "execute", "started_at": "2026-05-03T21:31:34.998097Z", "completed_at": "2026-05-03T21:31:34.998101Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0034513473510742188, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_databases.not_null_dividend_growth_inception_delta_growth.fe1d5d61c8", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nsele